QMainWindow, QWidget {
    background: #f6f4ef;
    color: #26332e;
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "Noto Sans CJK SC", sans-serif;
    font-size: 14px;
}

QLabel {
    background: transparent;
}

#sidebar {
    background: #173f36;
}

#brand {
    color: #f7f5ed;
    font-size: 28px;
    font-weight: 700;
}

#sidebarSubtitle {
    color: #bdd8c9;
    font-size: 13px;
}

#navButton {
    background: transparent;
    border: 0;
    border-radius: 10px;
    color: #d6e6db;
    min-height: 46px;
    padding: 0 16px;
    text-align: left;
}

#navButton:hover, #navButton[active="true"] {
    background: #2b5a4c;
    color: #ffffff;
}

#primaryAddButton, #primaryButton {
    background: #f2bd58;
    border: 0;
    border-radius: 10px;
    color: #173f36;
    font-weight: 700;
    min-height: 46px;
    padding: 0 16px;
}

#secondaryButton {
    background: #edf4ee;
    border: 1px solid #d5e4d8;
    border-radius: 8px;
    color: #1d4d3e;
    min-height: 34px;
    padding: 0 12px;
}

#secondaryButton:hover {
    background: #dcece0;
}

#primaryAddButton:hover, #primaryButton:hover {
    background: #ffd27b;
}

#pageTitle {
    color: #203a32;
    font-size: 30px;
    font-weight: 700;
}

#pageHint, #summaryCaption {
    color: #718078;
}

#summaryCard, #tableFrame, #placeholderPanel {
    background: #fffdf9;
    border: 1px solid #e7e2d8;
    border-radius: 14px;
}

#summaryValue {
    color: #1d4d3e;
    font-size: 25px;
    font-weight: 700;
}

#emptyState {
    color: #8a958f;
    font-size: 16px;
    min-height: 180px;
}

#expenseTable {
    background: #fffdf9;
    border: 0;
    gridline-color: #eee9df;
    selection-background-color: #e4f0e8;
    selection-color: #173f36;
}

#expenseTable::item {
    border-bottom: 1px solid #eee9df;
    padding: 10px;
}

#expenseTable QHeaderView::section {
    background: #f1eee6;
    border: 0;
    color: #68756e;
    font-weight: 700;
    padding: 11px 10px;
}

#dateFilter, QLineEdit, QDateEdit {
    background: #fffdf9;
    border: 1px solid #d8d5cc;
    border-radius: 8px;
    min-height: 34px;
    padding: 0 10px;
}

#budgetStatus {
    color: #4d6258;
    font-size: 16px;
}

QProgressBar {
    background: #e8e5dc;
    border: 0;
    border-radius: 7px;
    height: 14px;
    text-align: center;
}

QProgressBar::chunk {
    background: #efb74d;
    border-radius: 7px;
}

#categoryList {
    background: #fffdf9;
    border: 1px solid #e7e2d8;
    border-radius: 12px;
    padding: 6px;
}

#categoryList::item {
    border-radius: 7px;
    padding: 10px;
}

#categoryList::item:selected {
    background: #e1eee5;
    color: #173f36;
}

#dialogTitle {
    color: #203a32;
    font-size: 22px;
    font-weight: 700;
}

#dialogValue {
    color: #1d4d3e;
    font-weight: 700;
}

#errorLabel {
    color: #b34936;
}

#categoryChoice {
    background: #edf4ee;
    border: 1px solid #d5e4d8;
    border-radius: 9px;
    color: #1d4d3e;
    min-height: 42px;
    text-align: left;
    padding: 0 14px;
}

#categoryChoice:hover {
    background: #dcece0;
}
